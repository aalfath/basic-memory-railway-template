{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	# Health check for Railway: no token needed, answers only once the
	# start script has seen Basic Memory listening.
	handle /healthz {
		respond "ok" 200
	}

	@authorized header Authorization "Bearer {$MCP_BEARER_TOKEN}"
	handle @authorized {
		reverse_proxy 127.0.0.1:8000 {
			# FastMCP's DNS-rebinding guard rejects a public Host or a
			# browser Origin on a loopback connection; the token is the guard here.
			header_up Host 127.0.0.1:8000
			header_up -Origin
			flush_interval -1
		}
	}

	handle {
		header WWW-Authenticate "Bearer realm=\"basic-memory\""
		respond "Unauthorized: send Authorization: Bearer YOUR-MCP_BEARER_TOKEN" 401
	}
}
